{
  "name": "solarch",
  "version": "0.19.7",
  "description": "Solarch - The developer operating system for building, running, and managing modern backend applications.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xvertere-org/Solarch.git"
  },
  "homepage": "https://solarch.in/",
  "bugs": "https://github.com/xvertere-org/Solarch/issues",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./packages/core-client/dist/index.d.ts",
      "import": "./packages/core-client/dist/index.js",
      "require": "./packages/core-client/dist/index.cjs"
    }
  },
  "bin": {
    "solarch": "dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "scripts/postinstall.js",
    "packages/core-client/dist/**/*",
    "pb_public/**/*",
    "pb_migrations/**/*",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "packages/*"
  ],
  "solarchCi": {
    "type": "backend",
    "workspace": "root"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "build": "npm --workspace=@solarch/core-client run build --if-present && tsc && node -e \"require('fs').copyFileSync('src/tools/jsvm/deno_worker.ts', 'dist/tools/jsvm/deno_worker.ts')\"",
    "prepublishOnly": "npm run build",
    "dev": "tsx watch src/cli.ts serve --dev",
    "test": "vitest run",
    "test:pg": "bash scripts/pg-test-env.sh vitest run src/tools/database/contracts/postgres.contract.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@neondatabase/serverless": "^1.1.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "commander": "^12.0.0",
    "cors": "^2.8.5",
    "croner": "^8.0.0",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "mongodb": "^7.5.0",
    "morgan": "^1.10.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.3",
    "unzipper": "^0.12.5",
    "ws": "^8.21.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "esbuild": "^0.28.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^8.56.0",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

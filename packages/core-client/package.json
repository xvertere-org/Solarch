{
  "name": "@solarch/core-client",
  "version": "0.1.0",
  "description": "Universal, platform-neutral TypeScript client SDK for Solarch",
  "solarchCi": {
    "type": "sdk",
    "workspace": "@solarch/core-client"
  },
  "homepage": "https://solarch.in/",
  "repository": {
    "type": "git",
    "url": "https://github.com/xvertere-org/Solarch.git",
    "directory": "packages/core-client"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/utils tests/stores tests/unit tests/security",
    "test:platform": "node scripts/check-platform-boundary.cjs",
    "test:integration": "vitest run tests/http tests/conformance tests/integration",
    "test:realtime": "vitest run tests/realtime",
    "test:e2e": "vitest run tests/e2e",
    "test:package-shape": "node scripts/check-package-shape.cjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.4.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
